# Owner token. Required on any public deployment.
ALFRED_TOKEN=

# Model: Sprites Custom API connector for xAI Grok
LLM_CONNECTOR_ID=
LLM_MODEL=grok-4.7
# LLM_GATEWAY_URL=   # overrides the connector URL, for local testing

# Leash
ALFRED_APPROVE_TOOLS=fetch,box_write
ALFRED_ALLOWED_DOMAINS=

# Optional connectors. Prefer the gateway so the key never lands on the Sprite.
# EXA_API_KEY=          # direct key, sent as x-api-key. Leave empty when using the gateway.
EXA_GATEWAY_URL=
BOX_GATEWAY_URL=
BOX_ALLOWED_FOLDERS=
BOX_OUTBOX_ID=

# ALFRED_STATE=~/.alfred/state.json
# PORT=8080
